generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Config {
  id               Int      @id @default(1)
  autoReply        Boolean  @default(true)
  useOcr           Boolean  @default(false)
  mediaFormat      String   @default("original") // 'original' or 'webp_lossless'
  bufferMode       String   @default("fixed") // 'fixed' or 'debounce'
  bufferTimeout    Int      @default(3) // minutes
  catchupDays      Int      @default(3) // days
  catchupSessionGap Int     @default(30) // minutes
  catchupLimit     Int      @default(50) // messages per chat
  blacklistWords   String[] // Array of strings to ignore
  baseDirectory    String   @default("")
  updatedAt        DateTime @updatedAt
}

model TargetUser {
  id        String   @id // WhatsApp ID (e.g. 628123456789@c.us)
  name      String?
  createdAt DateTime @default(now())
}

model TargetGroup {
  id        String   @id // WhatsApp Group ID
  name      String?
  createdAt DateTime @default(now())
}

model ValidCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  aliases   String[] // Array of strings for aliases
  createdAt DateTime @default(now())
}

model ClientKeyword {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  aliases   String[] // Array of strings for aliases
  createdAt DateTime @default(now())
}

model Document {
  id        Int      @id @default(autoincrement())
  fileName  String
  filePath  String
  fileUrl   String?
  category  String
  client    String
  poNumber  String
  sender    String
  timestamp DateTime @default(now())
}

model LogHistory {
  id        Int      @id @default(autoincrement())
  type      String
  sender    String
  details   String
  status    String   // SUCCESS, ERROR, WARNING, INFO
  timestamp DateTime @default(now())
}

model FolderMapping {
  id         String   @id // The senderId (group or user ID)
  folderName String   // The exact folder name to save their files to
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// --- WACRM HYBRID: PHASE 1 (CONTACTS) ---

model Contact {
  id        String   @id @default(cuid())
  phone     String   @unique // WhatsApp ID (e.g. 628123456789@c.us)
  name      String?
  email     String?
  company   String?
  avatarUrl String?
  tags      ContactTag[]
  deals     Deal[]
  broadcastTargets BroadcastTarget[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  contacts  ContactTag[]
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

// --- WACRM HYBRID: PHASE 2 (PIPELINES & DEALS) ---

model Pipeline {
  id        String   @id @default(cuid())
  name      String
  stages    Stage[]
  deals     Deal[]
  createdAt DateTime @default(now())
}

model Stage {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  position   Int
  color      String
  deals      Deal[]
  createdAt  DateTime @default(now())
}

model Deal {
  id          String   @id @default(cuid())
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId     String
  stage       Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title       String
  value       Float    @default(0)
  currency    String?  @default("USD")
  notes       String?
  status      String   @default("open") // 'open', 'won', 'lost'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- WACRM HYBRID: PHASE 3 (BROADCASTS) ---

model Broadcast {
  id               String   @id @default(cuid())
  name             String
  message          String
  status           String   @default("draft") // draft, sending, completed, failed
  totalRecipients  Int      @default(0)
  sentCount        Int      @default(0)
  scheduledAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  targets          BroadcastTarget[]
}

model BroadcastTarget {
  id           String @id @default(cuid())
  broadcastId  String
  contactId    String
  status       String @default("pending") // pending, sent, failed
  errorMsg     String?
  
  broadcast    Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

// --- WACRM HYBRID: PHASE 4 (AUTOMATIONS) ---

model Automation {
  id              String   @id @default(cuid())
  name            String
  description     String?
  triggerType     String   // new_message_received, keyword_match, new_contact_created, tag_added, time_based
  triggerConfig   Json     @default("{}")
  steps           Json     @default("[]")
  isActive        Boolean  @default(false)
  executionCount  Int      @default(0)
  lastExecutedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
